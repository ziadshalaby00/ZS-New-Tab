{
  "manifest_version": 3,
  "name": "ZS New Tab",
  "short_name": "New Tab",
  "version": "8.3.0",
  "description": "A clean and customizable new tab page with bookmarks, quick search, drag-and-drop organization, custom backgrounds, themes, flexible layouts, and local backup and restore — with no accounts or tracking.",
  "author": "Ziad Shalaby",
  "minimum_chrome_version": "88",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "./icons/favicon-16x16.png",
    "48": "./icons/favicon-48x48.png",
    "128": "./icons/favicon-128x128.png"
  },
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/"
  ],
  "incognito": "split",
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@ziadshalaby.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}